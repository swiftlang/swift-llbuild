# Verify that implicit outputs are tracked for up-to-date checks: removing an
# implicit output forces its producing command to rerun.
#
# We run the build in a sandbox in the temp directory to avoid touching the
# source tree.
#
# RUN: rm -rf %t.build
# RUN: mkdir -p %t.build
# RUN: cp %s %t.build/build.ninja
# RUN: touch %t.build/dummy_in1
# RUN: %{llbuild} ninja build --jobs 1 --chdir %t.build &> %t1.out
# RUN: %{FileCheck} --check-prefix CHECK-INITIAL < %t1.out %s
#
# RUN: %{llbuild} ninja build --jobs 1 --chdir %t.build &> %t2.out
# RUN: %{FileCheck} --check-prefix CHECK-NULL < %t2.out %s
#
# RUN: rm %t.build/dummy_out2
# RUN: %{llbuild} ninja build --jobs 1 --chdir %t.build &> %t3.out
# RUN: %{FileCheck} --check-prefix CHECK-REBUILD < %t3.out %s

# The initial build runs the rule, producing the explicit and implicit outputs.
# `${out}` expands to the explicit output only.
# CHECK-INITIAL: RULE A -- dummy_in1 -- dummy_out1

# With both outputs present and inputs unchanged, the rebuild is a no-op.
# CHECK-NULL-NOT: RULE A
# CHECK-NULL: no work to do

# Removing the implicit output invalidates the command, forcing it to rerun.
# CHECK-REBUILD: RULE A -- dummy_in1 -- dummy_out1

rule A
     command = echo "RULE A -- ${in} -- ${out}" && touch "${out}" dummy_out2

build dummy_out1 | dummy_out2: A dummy_in1
